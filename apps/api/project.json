{
  "name": "api",
  "root": "apps/api",
  "targets": {
    "dev": { "executor": "nx:run-commands", "options": { "command": "pnpm --filter @flasharo/api dev" }, "continuous": true },
    "build": { "executor": "nx:run-commands", "options": { "command": "pnpm --filter @flasharo/api build" }, "outputs": ["{projectRoot}/dist"] },
    "typecheck": { "executor": "nx:run-commands", "options": { "command": "pnpm --filter @flasharo/api typecheck" } },
    "test": { "executor": "nx:run-commands", "options": { "command": "pnpm --filter @flasharo/api test" } }
  }
}
